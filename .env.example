# Future external services
DATABASE_URL=
SQLSERVER_HOST=
SQLSERVER_DATABASE=
SQLSERVER_USER=
SQLSERVER_PASSWORD=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# ============================================================
# Microsoft Entra ID
# ============================================================

# IDs de grupos de seguridad de Microsoft Entra ID.
# Usar siempre el Object ID del grupo, no su nombre visible.

ENTRA_ACCESS_GROUP_ID=

ENTRA_GROUP_ADMIN_ID=
ENTRA_GROUP_SUPERVISOR_ID=
ENTRA_GROUP_COLLECTOR_ID=
ENTRA_GROUP_AUDITOR_ID=

ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
ENTRA_CLIENT_SECRET=

# ============================================================
# Microsoft Entra ID
# ============================================================

# Habilitación general del proveedor.
ENTRA_AUTH_ENABLED=False

# Identificadores del App Registration.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Secreto exclusivo del backend.
# Nunca guardar el valor real en este archivo.
ENTRA_CLIENT_SECRET=

# URL absoluta registrada en Microsoft Entra ID.
ENTRA_REDIRECT_URI=http://localhost:8000/accounts/auth/callback/

# Grupo obligatorio para acceder a Invoice Flow.
ENTRA_ACCESS_GROUP_ID=

# Mapeo de grupos funcionales hacia roles Django.
ENTRA_GROUP_ADMIN_ID=
ENTRA_GROUP_SUPERVISOR_ID=
ENTRA_GROUP_COLLECTOR_ID=
ENTRA_GROUP_AUDITOR_ID=

# Scopes solicitados durante el flujo de autorización.
ENTRA_SCOPES=User.Read GroupMember.Read.All

# Políticas de sesión e identidad.
IDENTITY_REVALIDATION_MINUTES=15
IDENTITY_REVALIDATION_GRACE_MINUTES=5

# Logout global de Microsoft.
ENTRA_GLOBAL_LOGOUT_ENABLED=False

# Login local de desarrollo.
DEV_LOGIN_ENABLED=True