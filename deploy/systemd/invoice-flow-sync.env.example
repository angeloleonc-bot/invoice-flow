# Directorio absoluto del proyecto en Ubuntu.
INVOICE_FLOW_PROJECT_DIR=/opt/apps/invoice-flow

# Archivo Docker Compose relativo al directorio del proyecto.
INVOICE_FLOW_COMPOSE_FILE=compose.yml

# Servicio Docker que ejecuta Django.
INVOICE_FLOW_DJANGO_SERVICE=web

# Archivo de bloqueo para evitar ejecuciones simultáneas.
INVOICE_FLOW_SYNC_LOCK_FILE=/run/lock/invoice-flow-operational-sync.lock

# Verbosidad del management command: 0, 1, 2 o 3.
INVOICE_FLOW_SYNC_VERBOSITY=1